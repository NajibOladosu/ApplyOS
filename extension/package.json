{
  "name": "applyos-extension",
  "version": "1.1.0",
  "description": "Autofill job applications, generate tailored cover letters, and track every application in one place.",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "npm run audit && npm run typecheck && webpack --mode production --env browser=chrome",
    "build:chrome": "webpack --mode production --env browser=chrome",
    "build:firefox": "webpack --mode production --env browser=firefox",
    "build:edge": "webpack --mode production --env browser=edge",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-permissions.mjs",
    "test": "vitest run --config vitest.config.ts",
    "package": "node scripts/package.mjs",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "keywords": [
    "applyos",
    "job-applications",
    "browser-extension"
  ],
  "author": "ApplyOS",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "dotenv-webpack": "^8.1.1",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
